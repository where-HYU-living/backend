# docker compose 가 읽는 로컬 설정. 이 파일을 .env 로 복사해서 쓴다 (.env 는 git 에 올라가지 않는다)
#   cp .env.example .env && echo "JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n=')" >> .env  (아래 JWT_SECRET= 줄은 지운다)
# 로그인 토큰 서명 비밀값. 32자 이상, 사람마다 달라도 된다. 배포 서버(Railway)에는 따로 다른 값을 넣는다.
JWT_SECRET=
# 8080 이 이미 쓰이고 있으면 다른 포트
# API_PORT=8081

MOLIT_KEY=
TMAP_KEY=
KAKAO_REST_KEY=
